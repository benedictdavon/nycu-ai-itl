# Copy to `.env` in the repo root. Every value below is the default.
# LLM_BACKEND=fake needs no model server: tests and the API run without a model.
# Use LLM_BACKEND=llama_server for a real model (setup: backend/README.md).

LLM_BACKEND=fake
# OpenAI-compatible root of llama-server, including /v1.
LLM_BASE_URL=http://localhost:8080/v1
# Sent as a Bearer token when set. Must match the server's --api-key. Never commit it.
LLM_API_KEY=
# Optional: llama-server serves one model and ignores the name.
LLM_MODEL=
LLM_TIMEOUT_S=120

# Relative paths are resolved against the repo root.
DB_PATH=data/app.sqlite3
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
